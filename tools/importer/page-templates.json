            ".slider-section-2-wrap .marquee-brand"
          ]
        },
        {
          "name": "cards-media",
          "instances": [
            ".core-brand-section .fusion-post-cards"
          ]
        },
        {
          "name": "columns-panel",
          "instances": [
            "#wide-width-section"
          ]
        },
        {
          "name": "hero-cta",
          "instances": [
            ".brand-guidelines-section"
          ]
        }
      ],
      "sections": [
        {
          "id": "rc3",
          "name": "Hero video banner",
          "selector": [
