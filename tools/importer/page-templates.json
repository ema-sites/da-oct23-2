          "style": "light-lavender",
          "blocks": [
            "columns-intro"
          ],
          "defaultContent": []
        },
        {
          "id": "rc5",
          "name": "Photo marquee",
          "selector": [
            ".slider-section-wrap"
          ],
          "style": null,
          "blocks": [
            "carousel-marquee"
          ],
          "defaultContent": []
        },
        {
          "id": "rc6",
          "name": "Core brand elements",
          "selector": [
            ".core-brand-section"
          ],
          "style": "light-lavender, centered",
          "blocks": [
            "cards-media"
          ],
          "defaultContent": [
            ".core-brand-section .fusion-column-no-min-height"
